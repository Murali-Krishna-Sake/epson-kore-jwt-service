# Server
PORT=3001

# Redis
REDIS_URL=redis://localhost:6379

# CORS (comma-separated). localhost / 127.0.0.1 are always allowed in dev.
ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Kore public JWK used for JWE encryption (single-line JSON, shared across all bots)
KORE_JWK={"kty":"RSA","kid":"k-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx","n":"...","e":"AQAB"}

# Trust proxy hops in front of the app (e.g. ALB = 1, CloudFront + ALB = 2).
# Leave unset / empty for local dev with no proxy.
# TRUST_PROXY=1

# Per-bot credentials. Bot metadata (botName, botId) lives in src/config/bots.ts;
# only clientId and clientSecret are read from env. Add one pair per bot defined there.
EPSON_CF_LATIN_AMERICA_DEV_CLIENT_ID=cs-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EPSON_CF_LATIN_AMERICA_DEV_CLIENT_SECRET=your-secret-here

EPSON_CF_BRAZIL_DEV_CLIENT_ID=cs-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EPSON_CF_BRAZIL_DEV_CLIENT_SECRET=your-secret-here

EPSON_CF_NORTH_AMERICA_DEV_CLIENT_ID=cs-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EPSON_CF_NORTH_AMERICA_DEV_CLIENT_SECRET=your-secret-here

EPSON_AF_NORTH_AMERICA_DEV_CLIENT_ID=cs-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EPSON_AF_NORTH_AMERICA_DEV_CLIENT_SECRET=your-secret-here
