# Server
PORT=3001

# Redis
REDIS_URL=redis://localhost:6379

# Kore credentials
CLIENT_ID=cs-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_SECRET=replace-with-kore-client-secret

ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Kore public JWK used for JWE encryption (single-line JSON)
KORE_JWK={"kty":"RSA","kid":"k-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx","n":"...","e":"AQAB"}
